# =====================================================================================
#  Khóa AI cho Vinmec Pharmacy Hub – OCR hóa đơn + nhập bằng giọng nói
#  - File .env (cùng nội dung này) KHÔNG được commit (.gitignore đã chặn), KHÔNG lên Vercel (.vercelignore).
#  - Dùng ở máy: npm run dev (chạy app + AI), npm run eval (đánh giá so sánh).
#  - Đưa lên Vercel: npm run env:push  rồi  npm run deploy
#  - Mỗi dòng *_MODEL ghi được NHIỀU mô hình, cách nhau dấu phẩy:
#      app dùng mô hình ĐẦU TIÊN; npm run eval chạy thử TẤT CẢ để so sánh.
#  - Để trống khóa nào thì bỏ qua nhà cung cấp đó.
# =====================================================================================

# Nhà cung cấp mặc định của app: openai | gemini | qwen | local (trống = cái đầu tiên có khóa theo thứ tự đó).
# Dược sĩ vẫn đổi được trong app: Khác → Cài đặt → thẻ AI.
AI_OCR_PROVIDER=
AI_STT_PROVIDER=

# ---------- OpenAI – https://platform.openai.com/api-keys ----------
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ---------- Google Gemini – https://aistudio.google.com/apikey ----------
# Lưu ý: khóa gói MIỄN PHÍ cho phép Google dùng dữ liệu để cải tiến sản phẩm; gói trả phí thì không.
# gemini-3.5-transcribe là mô hình chuyên nhận giọng nói (có tiếng Việt, danh sách từ vựng tên thuốc).
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_STT_MODEL=gemini-3.5-flash-lite,gemini-3.5-transcribe

# ---------- Qwen trên Alibaba Cloud Model Studio (DashScope) – https://modelstudio.console.alibabacloud.com ----------
# Khóa vùng Singapore (quốc tế) và Bắc Kinh KHÁC nhau. Vùng Bắc Kinh: https://dashscope.aliyuncs.com/compatible-mode/v1
# qwen3-vl-plus: mô hình thị giác đa năng; qwen-vl-ocr-2025-11-20: mô hình chuyên OCR. qwen3-asr-flash: nhận giọng nói (có tiếng Việt).
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen3-vl-plus,qwen-vl-ocr-2025-11-20
QWEN_STT_MODEL=qwen3-asr-flash

# ---------- Qwen tự cài như thiết kế ban đầu (Ollama / vLLM, API kiểu OpenAI) – không cần khóa ----------
# VD Ollama trên chính máy này: LOCAL_AI_URL=http://localhost:11434/v1  (ollama pull qwen2.5vl:7b)
# Chỉ dùng được với npm run dev / npm run eval trong mạng nội bộ; bản Vercel không gọi tới máy nội bộ được.
# LOCAL_STT_MODEL: chỉ điền nếu có máy chủ whisper kiểu OpenAI (/v1/audio/transcriptions) ở cùng địa chỉ.
LOCAL_AI_URL=
LOCAL_AI_KEY=
LOCAL_OCR_MODEL=qwen2.5vl:7b
LOCAL_STT_MODEL=
